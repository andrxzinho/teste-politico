# Nomes das variáveis de ambiente do servidor. Os valores ficam só nas variáveis do Vercel (marcadas como Sensitive).
# Nunca coloque valores reais neste arquivo nem em nenhum outro do repositório.

# Banco do estudo (Supabase). Obrigatórias em produção.
SUPABASE_URL=
SUPABASE_CHAVE_SITE=          # chave secreta do site (tem prioridade)
SUPABASE_SECRET_KEY=

# Protege a tarefa diária de backup (/api/backup), chamada pelo agendador do Vercel.
CRON_SECRET=

# Senha do painel (/painel). Sem ela, o painel pede pra criar uma credencial no primeiro acesso.
PAINEL_SENHA=

# Data (AAAA-MM-DD) a partir da qual os resultados reais entram nas estatísticas do painel.
COLETA_INICIO=

# Testes e desenvolvimento local: guarda tudo na memória, sem banco.
# BANCO=memoria
