# Nomes das variáveis de ambiente do servidor. Os valores ficam só nas variáveis do Vercel (marcadas como Sensitive).
# Nunca coloque valores reais neste arquivo nem em nenhum outro do repositório.

# Banco do estudo (Supabase). Obrigatórias em produção.
SUPABASE_URL=
SUPABASE_CHAVE_SITE=          # chave secreta do site

# Segredo do limite de pedidos por visitante (fica fora do banco).
LIMITE_SEGREDO=

# Protege a tarefa diária de backup (/api/backup), chamada pelo agendador do Vercel.
CRON_SECRET=

# Senha do painel (/painel), com 16 caracteres ou mais. Sem ela, o painel pede pra criar uma credencial no primeiro acesso.
PAINEL_SENHA=

# Data (AAAA-MM-DD) em que o estudo começa a aceitar resultados. Sem ela, vale 2026-10-01.
COLETA_INICIO=

# Data (AAAA-MM-DD) em que o estudo para de aceitar resultados. Sem ela, vale 2027-12-31.
FIM_ESTUDO=

# Testes e desenvolvimento local: guarda tudo na memória, sem banco.
# BANCO=memoria
